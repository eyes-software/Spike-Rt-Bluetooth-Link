<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- BLE (Windows.Devices.Bluetooth の投影) を使うため 10.0.19041 を指定する -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BluetoothLink</RootNamespace>
    <AssemblyName>BluetoothLink</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    製品バージョン。機能追加は 1.1.0、修正は 1.0.1 のように上げる (セマンティックバージョニング)。
    AssemblyVersion / FileVersion はここから自動で決まり、画面のタイトルバーにも表示される。
  -->
  <PropertyGroup>
    <Version>1.1.3</Version>
    <Product>BluetoothLink</Product>
    <Description>Bluetooth Classic (RFCOMM/SPP) と BLE (GATT) に対応したデータ送受信ツール</Description>
    <Company>EYES-SOFTWARE Co.,Ltd.</Company>
    <Copyright>Copyright © EYES-SOFTWARE Co.,Ltd.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bluetooth Classic (RFCOMM/SPP) -->
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.4" />
    <!-- Bluetooth Low Energy (GATT) -->
    <PackageReference Include="InTheHand.BluetoothLE" Version="4.0.44" />
  </ItemGroup>

</Project>
